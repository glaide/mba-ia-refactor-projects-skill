@baseUrl = http://localhost:3000
@adminApiKey = dev-admin-key

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "payment_token": "tok_visa_ok"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "payment_token": "tok_declined"
}

### Relatório financeiro administrativo
GET {{baseUrl}}/api/admin/financial-report
x-api-key: {{adminApiKey}}

### Deletar usuário
DELETE {{baseUrl}}/api/users/1
x-api-key: {{adminApiKey}}
